# Build cecon for Linux with OpenBLAS/LAPACKE/gfortran STATICALLY linked, on an
# old-glibc base (Debian 11 = glibc 2.31) so the binary runs on any glibc >= 2.31
# host: Ubuntu 20.04/22.04/24.04, Debian 11/12, RHEL 9, Amazon Linux 2023, and
# (critically) the Cowork sandbox (Ubuntu 22.04 / glibc 2.35).
#
# Only libc/libm/libpthread remain dynamic — those exist on every Linux.
ARG BASE=debian:11-slim
FROM $BASE AS build

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential gfortran pkg-config python3 python3-pip \
      libopenblas-dev liblapacke-dev liblapack-dev \
      ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Debian 11 ships cmake 3.18; the project needs >= 3.20. Install a modern cmake
# from PyPI (lands in /usr/local/bin, ahead of /usr/bin on PATH).
RUN pip3 install --no-cache-dir "cmake>=3.25"

WORKDIR /src
COPY . /src

# Discover the arch-specific static archives. quadmath only exists on some arches
# (x86_64) — include it only if present. dl/pthread/m stay dynamic.
RUN set -e; \
    LAPACKE_A=$(find /usr/lib -name 'liblapacke.a'   | head -1); \
    OPENBLAS_A=$(find /usr/lib -name 'libopenblas.a' | head -1); \
    GFORTRAN_A=$(find /usr/lib -name 'libgfortran.a' | head -1); \
    QUADMATH_A=$(find /usr/lib -name 'libquadmath.a' | head -1); \
    LIBS="${LAPACKE_A};${OPENBLAS_A};${GFORTRAN_A}"; \
    if [ -n "$QUADMATH_A" ]; then LIBS="${LIBS};${QUADMATH_A}"; fi; \
    echo "STATIC LIBS = $LIBS"; \
    cmake -S . -B /build -DCMAKE_BUILD_TYPE=Release -DCECON_STATIC_LIBS="$LIBS" \
    && cmake --build /build -j"$(nproc)" --target cobra bench_demean \
    && strip --strip-unneeded /build/cobra /build/bench_demean

FROM scratch AS export
COPY --from=build /build/cobra /cobra
COPY --from=build /build/bench_demean /bench_demean
