* ============================================================================
* csdid_agg_scalars.do — Stata truth for csdid AGGREGATE scalars (MI-049 fill)
* Eval Harness §10 golden source.  StataNow BE 19.5 + SSC csdid.
*
* Purpose: pin the estat simple / estat event aggregate ATTs (simple ATT,
* Pre_avg, Post_avg) with their SEs and p-values, plus the unit count, for the
* csdid_cluster_event case — cobra emits simple_att/simple_se/pre_avg/
* pre_avg_se/post_avg/post_avg_se/n_units; only simple_att/simple_se were
* asserted before this capture.
*
* Model (== the manifest csdid_cluster_event case):
*   csdid y x, ivar(unit) time(t) gvar(g) method(dripw) cluster(clu)
* Data: csdid_cluster_synth.dta — generated by the committed recipe
*   tests/validate/csdid_cluster_golden.do (set seed 20260628; 60 clusters x
*   5 units x 8 periods = 2400 rows); .dta lives at
*   tests/validate/csdid_cluster_synth.dta (generated, not committed);
*   the engine-side fixture tests/validate/csdid_cluster_synth.hbin is committed.
*
* NO-GAMING CROSS-CHECK: the estat simple block must reproduce the ALREADY-
* COMMITTED csdid_cluster_event.csv golden (simple_att=1.003548392075270e+00,
* simple_se=1.113470271483817e-01) — proving this .dta is the same data the
* committed goldens were captured from. Only then are the new aggregate cells
* transcribed.
*
* Run:  cd tests/eval/golden && StataBE -b do csdid_agg_scalars.do
* Truth values transcribed (%21.15e) into csdid_cluster_event.csv by the Eval
* curator, validated against this log, then committed (Constitution §10).
* ============================================================================
clear all
set more off
set type double
capture log close
log using "csdid_agg_scalars.log", replace text

use "../../validate/csdid_cluster_synth.dta", clear
quietly distinct unit
display "N_UNITS_DISTINCT=" r(ndistinct)

xtset unit t
csdid y x, ivar(unit) time(t) gvar(g) method(dripw) cluster(clu)
display "CSDID_N=" %21.15e e(N)

* ---- estat simple: ATT + SE + z + p (cross-check + p capture) ----
estat simple
matrix Rs = r(table)
display "SIMPLE_BEGIN"
display %21.15e Rs[1,1] " = simple ATT   (want committed 1.003548392075270e+00)"
display %21.15e Rs[2,1] " = simple SE    (want committed 1.113470271483817e-01)"
display %21.15e Rs[3,1] " = simple z"
display %21.15e Rs[4,1] " = simple p"
display "SIMPLE_END"

* ---- estat event: every aggregate row (Pre_avg / Post_avg / tm* / tp*) ----
estat event
matrix Re = r(table)
local names : colnames Re
local k = colsof(Re)
display "EVENT_AGG_BEGIN  k=" `k'
forvalues j = 1/`k' {
    local nm : word `j' of `names'
    display "`nm' b  = " %21.15e Re[1,`j']
    display "`nm' se = " %21.15e Re[2,`j']
    display "`nm' z  = " %21.15e Re[3,`j']
    display "`nm' p  = " %21.15e Re[4,`j']
}
display "EVENT_AGG_END"

log close
